---
import '../styles/global.css';
import { t } from '../i18n/ui';
import { homePath, type Lang } from '../lib/content';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path to the equivalent page in the other language, if known. */
  altHref?: string;
}

const { lang, title, description, altHref } = Astro.props;
const strings = t(lang);
const pageTitle = `${title} · ${strings.siteTitle}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script is:inline define:vars={{ lang, cookiePath: import.meta.env.BASE_URL }}>
      // Remember the language currently being read, so a later visit to "/"
      // goes straight back here instead of guessing again.
      document.cookie = 'lang=' + lang + '; path=' + cookiePath + '; max-age=31536000; samesite=lax';
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homePath(lang)}>
        <svg class="compass-mark" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <circle cx="11" cy="11" r="9.5" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M11 4.5 L13.2 11 L11 17.5 L8.8 11 Z" fill="currentColor" />
        </svg>
        {strings.siteTitle}
      </a>
      <nav>
        <LanguageSwitcher lang={lang} altHref={altHref} />
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{strings.tagline}</p>
    </footer>
  </body>
</html>
