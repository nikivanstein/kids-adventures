---
import { homePath } from '../lib/content';

const nlHref = homePath('nl');
const enHref = homePath('en');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kids Adventures · Kinderavonturen</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${enHref}`} />
    </noscript>
    <script is:inline define:vars={{ nlHref, enHref }}>
      (function () {
        function readCookie(name) {
          const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
          return match ? decodeURIComponent(match[1]) : null;
        }

        const saved = readCookie('lang');
        if (saved === 'nl') {
          location.replace(nlHref);
          return;
        }
        if (saved === 'en') {
          location.replace(enHref);
          return;
        }

        const browserLangs = navigator.languages || [navigator.language || ''];
        const prefersDutch = browserLangs.some((l) => /^nl\b/i.test(l));
        location.replace(prefersDutch ? nlHref : enHref);
      })();
    </script>
  </head>
  <body>
    <noscript>
      <main style="text-align:center; padding-top: 4rem; font-family: sans-serif;">
        <p style="display:flex; gap:1.5rem; justify-content:center;">
          <a href={enHref}>English</a>
          <a href={nlHref}>Nederlands</a>
        </p>
      </main>
    </noscript>
  </body>
</html>
