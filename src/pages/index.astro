    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <main style="text-align:center; padding-top: 4rem;">
      <h1>🧸 Kids Adventures / Kinderavonturen</h1>
      <p style="display:flex; gap:1.5rem; justify-content:center; margin-top:2rem;">
